# Copy this file to .env and fill in your own values.
# .env is ignored by Git. NEVER commit a real device access token.
# If a variable is already set in your terminal, that value is used instead.

# Hostname of your ThingsBoard MQTT broker, WITHOUT https:// and WITHOUT a port.
# ThingsBoard Cloud, North America: mqtt.thingsboard.cloud
# ThingsBoard Cloud, Europe:        mqtt.eu.thingsboard.cloud
# Self-hosted server:               the IP/domain of that server
# NOTE: demo.thingsboard.io is a demo web account, NOT the Cloud MQTT host.
THINGSBOARD_HOST=mqtt.thingsboard.cloud

# RECOMMENDED: one device access token per virtual node.
# Copy each token from that device in the ThingsBoard web UI.
# Routing: FSN-01 -> Reservoir Outlet, FSN-02 -> Community Tap,
#          FSN-03 -> Tanker Fill Point.
FSN_01_TOKEN=replace-with-fsn-01-reservoir-outlet-token
FSN_02_TOKEN=replace-with-fsn-02-community-tap-token
FSN_03_TOKEN=replace-with-fsn-03-tanker-fill-point-token

# Legacy fallback from Stage 3. This is used ONLY when none of the three
# FSN_XX_TOKEN variables above are set. It sends every node to one device.
THINGSBOARD_TOKEN=replace-with-single-device-access-token
