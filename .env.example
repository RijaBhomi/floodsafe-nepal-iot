# Copy this file to .env and fill in your own values.
# .env is ignored by Git. NEVER commit a real device access token.
# If a variable is already set in your terminal, that value is used instead.

# Hostname of your ThingsBoard MQTT broker, WITHOUT https:// and WITHOUT a port.
# ThingsBoard Cloud, North America: mqtt.thingsboard.cloud
# ThingsBoard Cloud, Europe:        mqtt.eu.thingsboard.cloud
# Self-hosted server:               the IP/domain of that server
# NOTE: demo.thingsboard.io is a demo web account, NOT the Cloud MQTT host.
THINGSBOARD_HOST=mqtt.thingsboard.cloud

# Access token for ONE ThingsBoard device (for example FSN-01).
THINGSBOARD_TOKEN=replace-with-your-device-access-token
